// lrulfu.nv — least-frequently-used, as a value.
//
// An LFU cache evicts the entry that has been read the fewest times.
// A key read once an hour survives a burst of one-off keys that would
// push it out of an LRU cache.  The cost is a count per entry, and a
// count that stays high after the key stops being read.
//
// Two entries read the same number of times leave in the order of their
// last read, least recent first.  The tie-break makes the eviction
// order a function of the cache's contents, so a test can assert on it.

use lruevict

// One entry, as the cache stores it.
pub struct LruLfuEntry<V>
    // The key the entry is stored under.
    key: Str
    // The value.
    value: V
    // How many times `get` has answered this entry, including the put
    // that created it.
    uses: Int

// A cache that evicts the least frequently used entry.
pub struct LruLfuCache<V>
    // The entries.  `eviction_order` is what states their order.
    entries: [LruLfuEntry<V>]
    // The most entries the cache will hold.
    max_entries: Int

// The answer to a lookup: the value, and the cache that counted it.
pub struct LruLfuLookup<V>
    // The cache with the use counted.  Keep it.
    cache: LruLfuCache<V>
    // The value, or `None` on a miss.
    value: ?V

// The answer to a write: the cache, and everything that left it.
pub struct LruLfuPut<V>
    // The cache after the write.
    cache: LruLfuCache<V>
    // What was evicted, with the reason each left for.
    evicted: [lruevict.LruEvicted<V>]

// An empty cache that holds at most `max_entries` entries.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(64)
//     println("${lrulfu.len(c)}")               // 0
// ```
pub fn new<V>(max_entries: Int) -> LruLfuCache<V>
    LruLfuCache { entries: [], max_entries: max_entries }

// Store a value, with a use count of one.
//
// A new entry starts at one use rather than zero, so the entry written
// just now is not the first one evicted by a cache that is already
// full of entries read once.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(2)
//     let p = lrulfu.put(c, "a", 1)
//     println("${lrulfu.len(p.cache)}")         // 1
// ```
pub fn put<V>(c: LruLfuCache<V>, key: Str, value: V) -> LruLfuPut<V>
    var evicted: [lruevict.LruEvicted<V>] = []
    var uses = 1
    var rest: [LruLfuEntry<V>] = []
    for e in c.entries
        if e.key == key
            uses = e.uses
            list.push(evicted, LruEvicted { key: e.key, value: e.value, reason: LruEntryReplaced })
        else
            list.push(rest, e)
    while c.max_entries > 0 and list.len(rest) >= c.max_entries
        let at = victim(rest)
        list.push(evicted,
            LruEvicted { key: rest[at].key, value: rest[at].value, reason: LruCapacityExceeded })
        rest = without(rest, at)
    let kept = list.concat([LruLfuEntry { key: key, value: value, uses: uses }], rest)
    LruLfuPut { cache: LruLfuCache { entries: kept, max_entries: c.max_entries }, evicted: evicted }

// Look a key up, and count the use.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     let r = lrulfu.get(c, "absent")
//     match r.value
//         Some(_) => println("hit")
//         None    => println("miss")
// ```
pub fn get<V>(c: LruLfuCache<V>, key: Str) -> LruLfuLookup<V>
    let at = index_of(c.entries, key)
    if at < 0
        return LruLfuLookup { cache: c, value: None }
    let hit = c.entries[at]
    let moved = list.concat([LruLfuEntry { key: hit.key, value: hit.value, uses: hit.uses + 1 }],
                            without(c.entries, at))
    LruLfuLookup { cache: LruLfuCache { entries: moved, max_entries: c.max_entries },
        value: Some(hit.value) }

// Read a key without counting a use.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     match lrulfu.peek(c, "absent")
//         Some(_) => println("present")
//         None    => println("absent")
// ```
pub fn peek<V>(c: LruLfuCache<V>, key: Str) -> ?V
    let at = index_of(c.entries, key)
    if at < 0
        return None
    Some(c.entries[at].value)

// How many times a key has been used, or `0` when it is not stored.
//
// The number the eviction order is computed from, readable so that a
// caller can see why an entry survived.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     println("${lrulfu.uses_of(c, "absent")}") // 0
// ```
pub fn uses_of<V>(c: LruLfuCache<V>, key: Str) -> Int
    let at = index_of(c.entries, key)
    if at < 0
        return 0
    c.entries[at].uses

// Remove a key.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     let p = lrulfu.remove(c, "absent")
//     println("${list.len(p.evicted)}")         // 0
// ```
pub fn remove<V>(c: LruLfuCache<V>, key: Str) -> LruLfuPut<V>
    let at = index_of(c.entries, key)
    if at < 0
        return LruLfuPut { cache: c, evicted: [] }
    let gone = c.entries[at]
    LruLfuPut {
        cache: LruLfuCache { entries: without(c.entries, at), max_entries: c.max_entries },
        evicted: [LruEvicted { key: gone.key, value: gone.value, reason: LruRemovedByCaller }] }

// Halve every use count, rounding down.
//
// The one answer to an LFU's own failure mode: a key that was popular
// last week otherwise outranks the key that is popular now for as long
// as the cache lives.  A caller ages the counts on a schedule it
// chooses — this package reads no clock, so it cannot choose one.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     println("${lrulfu.len(lrulfu.halve_uses(c))}")   // 0
// ```
pub fn halve_uses<V>(c: LruLfuCache<V>) -> LruLfuCache<V>
    let halved = list.map(c.entries, e => LruLfuEntry { key: e.key, value: e.value, uses: e.uses / 2 })
    LruLfuCache { entries: halved, max_entries: c.max_entries }

// How many entries are stored.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     println("${lrulfu.len(c)}")               // 0
// ```
pub fn len<V>(c: LruLfuCache<V>) -> Int
    list.len(c.entries)

// The entry limit the cache was built with.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     println("${lrulfu.capacity(c)}")          // 8
// ```
pub fn capacity<V>(c: LruLfuCache<V>) -> Int
    c.max_entries

// The keys in eviction order: fewest uses first, and among equal
// counts the least recently read first.
//
// ```novo
// use lrulfu
//
// fn main() [io]
//     let c: LruLfuCache<Int> = lrulfu.new(8)
//     println("${list.len(lrulfu.eviction_order(c))}") // 0
// ```
pub fn eviction_order<V>(c: LruLfuCache<V>) -> [Str]
    let oldest_first = list.rev(c.entries)
    var ranks: [(Int, Int)] = []
    for i in 0..list.len(oldest_first)
        list.push(ranks, (oldest_first[i].uses, i))
    list.sort(ranks)
    list.map(ranks, r => oldest_first[r.1].key)

// The position of `key` in the entries, or `-1`.
fn index_of<V>(entries: [LruLfuEntry<V>], key: Str) -> Int
    for i in 0..list.len(entries)
        if entries[i].key == key
            return i
    0 - 1

// The entries without the one at `at`.
fn without<V>(entries: [LruLfuEntry<V>], at: Int) -> [LruLfuEntry<V>]
    list.concat(entries[0:at], entries[at + 1:list.len(entries)])

// The position of the entry to evict: the fewest uses, and among those
// the least recently used, which is the one nearest the end.
fn victim<V>(entries: [LruLfuEntry<V>]) -> Int
    var at = list.len(entries) - 1
    for back in 2..list.len(entries) + 1
        let i = list.len(entries) - back
        if entries[i].uses < entries[at].uses
            at = i
    at
