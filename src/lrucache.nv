// lrucache.nv — least-recently-used, as a value.
//
// Every operation here takes a cache and answers a cache, and the
// cache it was given is left as it was.  `get` is one of them: a hit
// moves its entry to the most recently used end, which is a change to
// the cache, so `get` answers the value and the cache that recorded
// the hit.  A caller that drops the returned cache has dropped the
// recency update and will see a different eviction order.  `peek` is
// the read that changes nothing, for a metrics endpoint or a debugger.
//
// The capacity a cache is built with counts entries.  A caller whose
// entries differ in size, such as a page cache or a response cache,
// sets a maximum weight as well and supplies each entry's weight at
// the put.  Both limits hold at once: entries are evicted when either
// is exceeded.  A limit of `0` is no limit.
//
// The entries are a list, most recently used first.  A lookup walks
// it, and an operation that changes the cache builds a new one, so
// each operation takes time in proportion to the entries stored.  The
// package suits caches of hundreds of entries rather than millions.

use lruevict

// One entry, as the cache stores it.
pub struct LruEntry<V>
    // The key the entry is stored under.
    key: Str
    // The value.
    value: V
    // What the caller said this entry weighs, or `1` when it said
    // nothing.
    weight: Int

// A cache that evicts the least recently used entry.
//
// Built by `new` or `with_max_weight`.  The fields are readable so a
// caller can assert on them in a test and a dashboard can report them
// without a function call per number.
pub struct LruCache<V>
    // The entries, most recently used first.  Eviction takes the last.
    entries: [LruEntry<V>]
    // The most entries the cache will hold.  `0` means no entry limit,
    // which is only useful together with a weight limit.
    max_entries: Int
    // The most weight the cache will hold, or `0` for no weight limit.
    max_weight: Int
    // The sum of the stored entries' weights.
    weight: Int

// The answer to a lookup: the value, and the cache that recorded it.
pub struct LruLookup<V>
    // The cache with the recency updated.  Keep it.
    cache: LruCache<V>
    // The value, or `None` on a miss.
    value: ?V

// The answer to a write: the cache, and everything that left it.
pub struct LruPut<V>
    // The cache after the write.
    cache: LruCache<V>
    // What was evicted to make room, oldest first, each with its
    // reason.  Empty when nothing left.
    evicted: [lruevict.LruEvicted<V>]

// An empty cache that holds at most `max_entries` entries.
//
// `max_entries` of `0` means no entry limit.  A cache with neither an
// entry limit nor a weight limit never evicts, which is a map.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(128)
//     println("${lrucache.len(c)}")             // 0
// ```
pub fn new<V>(max_entries: Int) -> LruCache<V>
    LruCache { entries: [], max_entries: max_entries, max_weight: 0, weight: 0 }

// The same cache with a maximum total weight.
//
// The weight of an entry is whatever the caller says it is at the put:
// bytes for a page cache, rows for a query cache.  Both limits hold
// at once, so an entry is evicted when either the entry count or the
// total weight would be exceeded.  The limit is applied at the next
// write, so nothing leaves the cache here without being handed back.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let empty: LruCache<Str> = lrucache.new(0)
//     let c = lrucache.with_max_weight(empty, 1048576)
//     println("${lrucache.max_weight(c)}")      // 1048576
// ```
pub fn with_max_weight<V>(c: LruCache<V>, max_weight: Int) -> LruCache<V>
    LruCache { entries: c.entries,
        max_entries: c.max_entries,
        max_weight: max_weight,
        weight: c.weight }

// Store a value under a key, weighing `1`.
//
// A key already present is replaced, and the old value comes back as
// an `LruEntryReplaced` eviction so a write-back cache can flush it.
// The written entry becomes the most recently used.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(2)
//     let p = lrucache.put(c, "a", "alpha")
//     println("${lrucache.len(p.cache)}")       // 1
// ```
pub fn put<V>(c: LruCache<V>, key: Str, value: V) -> LruPut<V>
    put_weighed(c, key, value, 1)

// Store a value that weighs `weight`.
//
// A single entry heavier than the whole weight limit is refused rather
// than stored: it would evict everything and then not fit.  The put
// answers the unchanged cache and the new entry as an
// `LruWeightExceeded` eviction, so the caller learns which value was
// not stored.
//
// Otherwise the entry becomes the most recently used, a value it
// replaces comes back as `LruEntryReplaced`, and entries are evicted
// from the least recently used end until both limits hold.  Each of
// those is `LruCapacityExceeded` while the entry count is over its
// limit, and `LruWeightExceeded` after that.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let empty: LruCache<Str> = lrucache.new(0)
//     let c = lrucache.with_max_weight(empty, 4096)
//     let p = lrucache.put_weighed(c, "page-1", "...", 512)
//     println("${lrucache.weight(p.cache)}")    // 512
// ```
pub fn put_weighed<V>(c: LruCache<V>, key: Str, value: V, weight: Int) -> LruPut<V>
    if c.max_weight > 0 and weight > c.max_weight
        return LruPut {
            cache: c,
            evicted: [LruEvicted { key: key, value: value, reason: LruWeightExceeded }] }
    var evicted: [lruevict.LruEvicted<V>] = []
    var count = 1
    var held = weight
    for e in c.entries
        if e.key == key
            list.push(evicted, LruEvicted { key: e.key, value: e.value, reason: LruEntryReplaced })
        else
            count = count + 1
            held = held + e.weight
    let cut = evict_from_end(c.entries, true, key, count, held, c.max_entries, c.max_weight, evicted)
    let kept = list.concat([LruEntry { key: key, value: value, weight: weight }],
                           list.filter(c.entries[0:cut], e => e.key != key))
    LruPut {
        cache: LruCache { entries: kept, max_entries: c.max_entries, max_weight: c.max_weight,
                          weight: total_weight(kept) },
        evicted: evicted }

// Look a key up, and record the hit.
//
// On a hit the entry becomes the most recently used, which is the
// whole of what makes this cache an LRU.  The returned cache carries
// that; the value is `None` on a miss and the cache comes back
// unchanged.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     let r = lrucache.get(c, "absent")
//     match r.value
//         Some(_) => println("hit")
//         None    => println("miss")
// ```
pub fn get<V>(c: LruCache<V>, key: Str) -> LruLookup<V>
    let at = index_of(c, key)
    if at < 0
        return LruLookup { cache: c, value: None }
    let hit = c.entries[at]
    var moved: [LruEntry<V>] = [hit]
    for e in c.entries
        if e.key != key
            list.push(moved, e)
    LruLookup {
        cache: LruCache { entries: moved,
        max_entries: c.max_entries,
        max_weight: c.max_weight,
        weight: c.weight },
        value: Some(hit.value) }

// Read a key without recording a hit.
//
// The entry keeps its place in the eviction order.  This is the read
// for a metrics endpoint, a debugger and a test, none of which should
// change what the next eviction takes.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     match lrucache.peek(c, "absent")
//         Some(_) => println("present")
//         None    => println("absent")
// ```
pub fn peek<V>(c: LruCache<V>, key: Str) -> ?V
    for e in c.entries
        if e.key == key
            return Some(e.value)
    None

// Remove a key.
//
// The removed entry comes back as an `LruRemovedByCaller` eviction, so
// one code path handles a value leaving the cache however it left.  A
// key that was not there evicts nothing.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     let p = lrucache.remove(c, "absent")
//     println("${list.len(p.evicted)}")         // 0
// ```
pub fn remove<V>(c: LruCache<V>, key: Str) -> LruPut<V>
    var kept: [LruEntry<V>] = []
    var evicted: [lruevict.LruEvicted<V>] = []
    var total = 0
    for e in c.entries
        if e.key == key
            list.push(evicted, LruEvicted { key: e.key, value: e.value, reason: LruRemovedByCaller })
        else
            list.push(kept, e)
            total = total + e.weight
    LruPut {
        cache: LruCache { entries: kept, max_entries: c.max_entries, max_weight: c.max_weight, weight: total },
        evicted: evicted }

// Whether a key is stored, without recording a hit.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.contains(c, "absent")}")   // false
// ```
pub fn contains<V>(c: LruCache<V>, key: Str) -> Bool
    index_of(c, key) >= 0

// How many entries are stored.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.len(c)}")             // 0
// ```
pub fn len<V>(c: LruCache<V>) -> Int
    list.len(c.entries)

// The entry limit the cache was built with, or `0` for none.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.capacity(c)}")        // 8
// ```
pub fn capacity<V>(c: LruCache<V>) -> Int
    c.max_entries

// The total weight stored.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.weight(c)}")          // 0
// ```
pub fn weight<V>(c: LruCache<V>) -> Int
    c.weight

// The weight limit, or `0` for none.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.max_weight(c)}")      // 0
// ```
pub fn max_weight<V>(c: LruCache<V>) -> Int
    c.max_weight

// Whether the cache holds nothing.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.is_empty(c)}")        // true
// ```
pub fn is_empty<V>(c: LruCache<V>) -> Bool
    list.len(c.entries) == 0

// An empty cache with the same limits.
//
// Nothing is reported as evicted: a caller that drops a whole cache
// knows it did, and a list of everything it held is a copy of the
// cache it already has.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${lrucache.len(lrucache.clear(c))}")  // 0
// ```
pub fn clear<V>(c: LruCache<V>) -> LruCache<V>
    LruCache { entries: [], max_entries: c.max_entries, max_weight: c.max_weight, weight: 0 }

// The keys in eviction order: the next entry to be evicted first.
//
// The order is total and it is the order this package promises.  A
// test asserts on it, and a dashboard prints it.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${list.len(lrucache.eviction_order(c))}")   // 0
// ```
pub fn eviction_order<V>(c: LruCache<V>) -> [Str]
    var keys: [Str] = []
    for e in list.rev(c.entries)
        list.push(keys, e.key)
    keys

// The entries in eviction order, keys and values together.
//
// What a caller draining a cache into a store iterates.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     println("${list.len(lrucache.entries_in_eviction_order(c))}")  // 0
// ```
pub fn entries_in_eviction_order<V>(c: LruCache<V>) -> [LruEntry<V>]
    list.rev(c.entries)

// The key that would be evicted next, or `None` when the cache is
// empty.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     match lrucache.next_eviction(c)
//         Some(k) => println(k)
//         None    => println("nothing to evict")
// ```
pub fn next_eviction<V>(c: LruCache<V>) -> ?Str
    if list.len(c.entries) == 0
        return None
    Some(c.entries[-1].key)

// Evict entries until the cache holds at most `entries` entries.
//
// What a caller resizing a cache downwards needs.  The entry limit
// becomes `entries`, and everything dropped comes back as an
// `LruCapacityExceeded` eviction, least recently used first.  A limit
// of `0` is no limit, so `shrink_to(c, 0)` evicts nothing.
//
// ```novo
// use lrucache
//
// fn main() [io]
//     let c: LruCache<Str> = lrucache.new(8)
//     let p = lrucache.shrink_to(c, 4)
//     println("${lrucache.capacity(p.cache)}")  // 4
// ```
pub fn shrink_to<V>(c: LruCache<V>, entries: Int) -> LruPut<V>
    var evicted: [lruevict.LruEvicted<V>] = []
    let cut = evict_from_end(c.entries, false, "", list.len(c.entries), c.weight, entries, c.max_weight, evicted)
    let kept = c.entries[0:cut]
    LruPut {
        cache: LruCache { entries: kept,
        max_entries: entries,
        max_weight: c.max_weight,
        weight: total_weight(kept) },
        evicted: evicted }

// The sum of the entries' weights.
fn total_weight<V>(entries: [LruEntry<V>]) -> Int
    list.sum(list.map(entries, e => e.weight))

// The position of `key` in the entries, or `-1`.
fn index_of<V>(c: LruCache<V>, key: Str) -> Int
    for i in 0..list.len(c.entries)
        if c.entries[i].key == key
            return i
    0 - 1

// Walks `entries` from the least recently used end, adding to
// `evicted` each entry that has to leave for a cache of `count`
// entries weighing `held` to fit the two limits, and answers the index
// of the first entry that left, or the length when none did.  With
// `skipping` set, the entry under `skip` is passed over: it is the one
// a put replaces.
//
// Each entry leaves as `LruCapacityExceeded` while the entry count is
// over its limit, and as `LruWeightExceeded` after that.
fn evict_from_end<V>(entries: [LruEntry<V>], skipping: Bool, skip: Str, count: Int, held: Int,
                     max_entries: Int, max_weight: Int,
                     var evicted: [lruevict.LruEvicted<V>]) -> Int
    var left = count
    var weight_left = held
    var cut = list.len(entries)
    for back in 1..list.len(entries) + 1
        let over_count = max_entries > 0 and left > max_entries
        let over_weight = max_weight > 0 and weight_left > max_weight
        if not over_count and not over_weight
            break
        let e = entries[list.len(entries) - back]
        cut = list.len(entries) - back
        if not skipping or e.key != skip
            left = left - 1
            weight_left = weight_left - e.weight
            let reason = if over_count
                LruCapacityExceeded
            else
                LruWeightExceeded
            list.push(evicted, LruEvicted { key: e.key, value: e.value, reason: reason })
    cut
